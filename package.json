{
  "name": "m3-oklch",
  "version": "1.0.0",
  "description": "Material You color generator.",
  "license": "MPL-2.0",
  "author": "https://github.com/rakibdev",
  "repository": "https://github.com/rakibdev/m3-oklch.git",
  "files": [
    "build"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./build/main.js",
      "types": "./build/main.d.ts"
    }
  },
  "scripts": {
    "build": "bun build:src && bun build:types",
    "build:src": "bun build ./typescript/main.ts --outdir ./build --minify",
    "build:types": "tsc --project ./tsconfig.types.json"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@types/bun": "^1.2.15",
    "playwright-core": "^1.65.0",
    "typescript": "^5.8.3"
  }
}
